{
	"name": "notiondown",
	"displayName": "NotionDown",
	"description": "A Notion-style editor for Markdown in VS Code. Slash commands, drag-and-drop blocks, visual tables, live Mermaid diagrams, and plain Markdown on disk.",
	"version": "0.1.0",
	"icon": "assets/icon.png",
	"publisher": "KunalPathak",
	"author": "Kunal Pathak",
	"homepage": "https://github.com/kanad13/NotionDown",
	"bugs": {
		"url": "https://github.com/kanad13/NotionDown/issues"
	},
	"engines": {
		"vscode": "^1.105.0",
		"node": ">=22.22.2"
	},
	"categories": [
		"Notebooks",
		"Other"
	],
	"keywords": [
		"markdown",
		"notion",
		"wysiwyg",
		"editor",
		"md",
		"mermaid",
		"diagrams",
		"slash-commands",
		"milkdown",
		"block-editor",
		"live-preview",
		"privacy"
	],
	"qna": "marketplace",
	"galleryBanner": {
		"color": "#1f2328",
		"theme": "dark"
	},
	"main": "./dist/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "notionDown.editor",
				"displayName": "NotionDown",
				"selector": [
					{
						"filenamePattern": "*.md"
					}
				],
				"priority": "default"
			}
		],
		"commands": [
			{
				"command": "notionDown.openEditor",
				"title": "Open in NotionDown",
				"category": "Markdown",
				"icon": "$(edit)"
			},
			{
				"command": "notionDown.useAsDefault",
				"title": "Use NotionDown as the Default Markdown Editor",
				"category": "Markdown"
			},
			{
				"command": "notionDown.useTextEditorAsDefault",
				"title": "Use the VS Code Text Editor as the Default Markdown Editor",
				"category": "Markdown"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "notionDown.openEditor",
					"when": "resourceLangId == markdown && activeCustomEditorId != notionDown.editor",
					"group": "navigation"
				}
			],
			"explorer/context": [
				{
					"command": "notionDown.openEditor",
					"when": "resourceLangId == markdown",
					"group": "navigation"
				}
			]
		}
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"scripts": {
		"build": "webpack",
		"lint": "eslint .",
		"test": "npm run build && node --test test/ && npm run lint",
		"package": "npm run build && vsce package",
		"publish": "npm run build && vsce publish"
	},
	"dependencies": {
		"@codemirror/language-data": "^6.5.2",
		"@milkdown/crepe": "^7.22.3",
		"mermaid": "^12.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.5",
		"@types/vscode": "1.105.0",
		"@vscode/vsce": "^4.0.0",
		"css-loader": "^7.1.5",
		"eslint": "^10.13.0",
		"jsdom": "^30.1.2",
		"mini-css-extract-plugin": "^2.10.2",
		"webpack": "^5.112.2",
		"webpack-cli": "^7.2.3"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanad13/NotionDown.git"
	},
	"license": "MIT",
	"pricing": "Free",
	"overrides": {
		"katex": "0.19.0"
	}
}
