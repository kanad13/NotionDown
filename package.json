{
	"name": "notiondown",
	"displayName": "NotionDown",
	"description": "A Notion-style editor for Markdown in VS Code. Slash commands, drag-and-drop blocks, visual tables, live Mermaid diagrams, and plain Markdown on disk.",
	"version": "1.0.0",
	"icon": "assets/icon.png",
	"publisher": "KunalPathak",
	"author": "Kunal Pathak",
	"homepage": "https://github.com/kanad13/NotionDown",
	"bugs": {
		"url": "https://github.com/kanad13/NotionDown/issues"
	},
	"engines": {
		"vscode": "^1.105.0",
		"node": ">=22.22.2"
	},
	"categories": [
		"Notebooks",
		"Other"
	],
	"keywords": [
		"markdown",
		"markdown-editor",
		"visual-markdown",
		"notion",
		"notion-style",
		"wysiwyg",
		"editor",
		"md",
		"mermaid",
		"diagrams",
		"slash-commands",
		"milkdown",
		"block-editor",
		"live-preview",
		"katex",
		"latex",
		"table-editor",
		"notes",
		"privacy"
	],
	"qna": "marketplace",
	"galleryBanner": {
		"color": "#1f2328",
		"theme": "dark"
	},
	"main": "./dist/extension.js",
	"activationEvents": [
		"onLanguage:markdown"
	],
	"contributes": {
		"customEditors": [
			{
				"viewType": "notionDown.editor",
				"displayName": "NotionDown",
				"selector": [
					{
						"filenamePattern": "*.md"
					}
				],
				"priority": "default"
			}
		],
		"commands": [
			{
				"command": "notionDown.openEditor",
				"title": "Open in NotionDown",
				"category": "Markdown",
				"icon": "$(rocket-compact)"
			},
			{
				"command": "notionDown.useAsDefault",
				"title": "Use NotionDown as the Default Markdown Editor",
				"category": "Markdown"
			},
			{
				"command": "notionDown.useTextEditorAsDefault",
				"title": "Use the VS Code Text Editor as the Default Markdown Editor",
				"category": "Markdown"
			},
			{
				"command": "notionDown.openSource",
				"title": "Show Markdown Source in the Text Editor",
				"category": "Markdown",
				"icon": "$(code)"
			},
			{
				"command": "notionDown.showWalkthrough",
				"title": "Show NotionDown Screenshots",
				"category": "Markdown"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "notionDown.openEditor",
					"when": "resourceLangId == markdown && activeCustomEditorId != notionDown.editor",
					"group": "navigation"
				},
				{
					"command": "notionDown.openSource",
					"when": "activeCustomEditorId == notionDown.editor",
					"group": "navigation"
				}
			],
			"explorer/context": [
				{
					"command": "notionDown.openEditor",
					"when": "resourceLangId == markdown",
					"group": "navigation"
				}
			]
		},
		"walkthroughs": [
			{
				"id": "notionDown.welcome",
				"title": "Write Markdown like Notion",
				"description": "See what NotionDown looks like, then choose whether it opens your Markdown files.",
				"steps": [
					{
						"id": "canvas",
						"title": "One canvas, no preview pane",
						"description": "You edit the finished page. Task lists, tables and Mermaid diagrams render as you write, and the file on disk stays plain Markdown.",
						"media": {
							"image": {
								"dark": "assets/screenshots/overview-dark.png",
								"light": "assets/screenshots/overview-light.png",
								"hc": "assets/screenshots/overview-dark.png",
								"hcLight": "assets/screenshots/overview-light.png"
							},
							"altText": "NotionDown editing a note that has a task list and a Mermaid diagram."
						}
					},
					{
						"id": "slash",
						"title": "Type / for any block",
						"description": "Headings, lists, quotes, tables, code, math and diagrams are one slash away. Drag the handle beside a block to move it.",
						"media": {
							"image": {
								"dark": "assets/screenshots/slash-dark.png",
								"light": "assets/screenshots/slash-light.png",
								"hc": "assets/screenshots/slash-dark.png",
								"hcLight": "assets/screenshots/slash-light.png"
							},
							"altText": "The NotionDown slash menu listing block types."
						}
					},
					{
						"id": "details",
						"title": "Math, code and tables in place",
						"description": "Math renders with KaTeX, code blocks highlight, and tables are edited visually.",
						"media": {
							"image": {
								"dark": "assets/screenshots/details-dark.png",
								"light": "assets/screenshots/details-light.png",
								"hc": "assets/screenshots/details-dark.png",
								"hcLight": "assets/screenshots/details-light.png"
							},
							"altText": "Math, a code block, a table and a quote shown in NotionDown."
						}
					},
					{
						"id": "default",
						"title": "Choose your default Markdown editor",
						"description": "Open every `.md` file in NotionDown, or keep VS Code's text editor. You can switch at any time from the Command Palette.\\n[Use NotionDown](command:notionDown.useAsDefault)\\n[Keep the Text Editor](command:notionDown.useTextEditorAsDefault)",
						"media": {
							"image": {
								"dark": "assets/screenshots/overview-dark.png",
								"light": "assets/screenshots/overview-light.png",
								"hc": "assets/screenshots/overview-dark.png",
								"hcLight": "assets/screenshots/overview-light.png"
							},
							"altText": "NotionDown editing a note that has a task list and a Mermaid diagram."
						}
					}
				]
			}
		]
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"scripts": {
		"build": "webpack",
		"lint": "eslint .",
		"e2e": "node tools/e2e/run.js",
		"test": "npm run build && node --test \"test/*.test.js\" && npm run lint",
		"package": "npm run build && vsce package",
		"publish": "npm run build && vsce publish"
	},
	"dependencies": {
		"@codemirror/language-data": "^6.5.2",
		"@milkdown/crepe": "^7.22.3",
		"mermaid": "^12.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.5",
		"@types/vscode": "1.105.0",
		"@vscode/vsce": "^4.0.0",
		"css-loader": "^7.1.5",
		"eslint": "^10.13.0",
		"jsdom": "^30.1.2",
		"mini-css-extract-plugin": "^2.10.2",
		"ovsx": "^1.3.0",
		"webpack": "^5.112.2",
		"webpack-cli": "^7.2.3"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanad13/NotionDown.git"
	},
	"license": "MIT",
	"pricing": "Free",
	"overrides": {
		"katex": "0.19.0"
	}
}
